# docker compose가 읽는 배포 설정.
#
#   ./scripts/setup.sh env      ← 이 파일을 손으로 복사하지 말고 스크립트가 만들게 하라.
#                                  비밀번호를 무작위로 생성하고 Ollama 주소를 탐지해 채운다.
#
# .env는 커밋하지 않는다(.gitignore 대상). 이 예시 파일에는 실제 값을 넣지 않는다.

# 외부 Ollama 인스턴스 주소. compose는 Ollama를 띄우지 않는다.
# 기본값을 두지 않는 이유: 기동돼 있지 않은 주소를 조용히 가리키면 배포본이 조용히 실패한다.
# 컨테이너에서 호스트의 Ollama를 쓸 때는 host.docker.internal 또는 도커 브리지 게이트웨이 IP를 쓴다.
OLLAMA_URL=http://<ollama-host>:11434

GENERATE_MODEL=gemma4:e4b
EMBED_MODEL=nomic-embed-text:latest
TOP_K=5
TAU=0.55

# 웹 화면 포트(adapters.http_server).
WEB_PORT=8080

# PostgreSQL. 비밀번호는 setup.sh가 무작위 생성한다 — 값을 이 파일에 적지 마라.
POSTGRES_DB=companyx
POSTGRES_USER=postgres
# 호스트에 노출할 포트. 이미 다른 PostgreSQL이 5432를 쓰고 있으면 바꾼다.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=<generated>
# 애플리케이션이 쓰는 읽기 전용 계정. sql/05-roles.sh가 이 값으로 역할을 만든다.
MCP_READER_PASSWORD=<generated>
# 화면의 접속 프로필(server_connections)만 읽고 쓰는 계정. sql/06-server-connections.sh가 만든다.
# mcp_reader는 read-only라 프로필을 저장할 수 없고, read-only를 풀면 nl2sql의 2차 방어선이 사라진다.
MCP_CONFIG_PASSWORD=<generated>

# 배포본 추적용. setup.sh가 `git rev-parse --short HEAD`로 채운다.
BUILD_SHA=unknown
