# docker compose가 읽는 배포 설정. 실제 값은 `.env`로 복사해 채운다(.env는 커밋하지 않는다).
# OLLAMA_URL은 기본값이 없다 — 기동돼 있지 않은 주소를 조용히 가리키는 사고를 막기 위해서다.

# 외부 Ollama 인스턴스의 주소. compose는 Ollama를 띄우지 않는다.
OLLAMA_URL=http://192.168.159.1:11434

GENERATE_MODEL=gemma4:e4b
EMBED_MODEL=nomic-embed-text:latest
TOP_K=5
TAU=0.55

# 배포본 추적용. 빌드 시 `BUILD_SHA=$(git rev-parse --short HEAD)`로 채운다.
BUILD_SHA=unknown
